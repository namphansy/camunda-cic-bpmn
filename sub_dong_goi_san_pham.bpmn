<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" 
                  id="Definitions_Common4" 
                  targetNamespace="http://bpmn.io/schema/bpmn" 
                  exporter="Camunda Modeler" 
                  exporterVersion="5.x">

  <bpmn:process id="SubProcess_Common4_Delivery" name="Common 4: Đóng gói, Tính phí và Cung cấp Sản phẩm" isExecutable="true">
    
    <bpmn:startEvent id="Start_Common4" name="Start Delivery">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- GỌI DMN ENGINE TÍNH PHÍ THEO QĐ149 -->
    <bpmn:businessRuleTask id="Task_CalculateFee" name="Tính phí sản phẩm (QĐ149)" camunda:decisionRef="Pricing_QD149" camunda:resultVariable="calculatedFee" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_PackageData" name="Đóng gói SP &#38; Phần mềm tính phí" camunda:delegateExpression="${packageProductDelegate}">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DeliverResult" name="Gửi kết quả cho Đơn vị/Portal" camunda:delegateExpression="${deliverProductDelegate}">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_DeliverySuccess" name="Cung cấp SP thành công">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Common4" targetRef="Task_CalculateFee" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CalculateFee" targetRef="Task_PackageData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PackageData" targetRef="Task_DeliverResult" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_DeliverResult" targetRef="End_DeliverySuccess" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Common4">
    <bpmndi:BPMNPlane id="BPMNPlane_Common4" bpmnElement="SubProcess_Common4_Delivery">
      <bpmndi:BPMNShape id="Start_Common4_di" bpmnElement="Start_Common4">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalculateFee_di" bpmnElement="Task_CalculateFee">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PackageData_di" bpmnElement="Task_PackageData">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliverResult_di" bpmnElement="Task_DeliverResult">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_DeliverySuccess_di" bpmnElement="End_DeliverySuccess">
        <dc:Bounds x="692" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="120" /><di:waypoint x="390" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="490" y="120" /><di:waypoint x="540" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End"><di:waypoint x="640" y="120" /><di:waypoint x="692" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>