<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" 
                  id="Definitions_Common3" 
                  targetNamespace="http://bpmn.io/schema/bpmn" 
                  exporter="Camunda Modeler" 
                  exporterVersion="5.x">

  <bpmn:process id="SubProcess_Common3_Aggregation" name="Common 3: Tổng hợp Dữ liệu và Tạo lập Sản phẩm" isExecutable="true">
    
    <bpmn:startEvent id="Start_Common3" name="Start Aggregation">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_AggregatePerObject" name="Tổng hợp dữ liệu theo đối tượng" camunda:asyncBefore="true" camunda:delegateExpression="${aggregatePerObjectDelegate}">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AggregateAllAndBuild" name="Tổng hợp dữ liệu ĐTĐHT &#38; Tạo lập SP" camunda:asyncBefore="true" camunda:delegateExpression="${buildProductDataDelegate}">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_AggregationSuccess" name="Tạo lập thành công">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Common3" targetRef="Task_AggregatePerObject" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_AggregatePerObject" targetRef="Task_AggregateAllAndBuild" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_AggregateAllAndBuild" targetRef="End_AggregationSuccess" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Common3">
    <bpmndi:BPMNPlane id="BPMNPlane_Common3" bpmnElement="SubProcess_Common3_Aggregation">
      <bpmndi:BPMNShape id="Start_Common3_di" bpmnElement="Start_Common3">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AggregatePerObject_di" bpmnElement="Task_AggregatePerObject">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AggregateAllAndBuild_di" bpmnElement="Task_AggregateAllAndBuild">
        <dc:Bounds x="390" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AggregationSuccess_di" bpmnElement="End_AggregationSuccess">
        <dc:Bounds x="542" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="120" /><di:waypoint x="390" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End"><di:waypoint x="490" y="120" /><di:waypoint x="542" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>