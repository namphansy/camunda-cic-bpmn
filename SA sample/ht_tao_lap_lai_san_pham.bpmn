<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Common5" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="SubProcess_Common5_Feedback" name="Common 5: Kiểm soát Phản hồi và Tái tạo lập" isExecutable="true">
    <bpmn:startEvent id="Start_Common5" name="Start Feedback Check">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_HasFeedback" name="Có Phản hồi / Yêu cầu làm lại?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_HasFeedback_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasFeedback_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ControlRebuild" name="Kiểm soát &#38; Tạo lập lại Sản phẩm" camunda:delegateExpression="${rebuildProductDelegate}">
      <bpmn:incoming>Flow_HasFeedback_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CheckToanPhan" name="Kiểm tra tính toàn phần?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToanPhan_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToanPhan_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CheckStop" name="Cán bộ chọn Dừng trả lời?">
      <bpmn:incoming>Flow_ToanPhan_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Stop_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stop_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Completed" name="Hoàn tất xử lý">
      <bpmn:incoming>Flow_HasFeedback_No</bpmn:incoming>
      <bpmn:incoming>Flow_ToanPhan_Yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Stopped" name="Dừng tiếp tục xử lý YCHT">
      <bpmn:incoming>Flow_Stop_Yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Common5" targetRef="Gateway_HasFeedback" />
    <bpmn:sequenceFlow id="Flow_HasFeedback_Yes" name="Có" sourceRef="Gateway_HasFeedback" targetRef="Task_ControlRebuild">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasFeedback == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasFeedback_No" name="Không" sourceRef="Gateway_HasFeedback" targetRef="End_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasFeedback == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ControlRebuild" targetRef="Gateway_CheckToanPhan" />
    <bpmn:sequenceFlow id="Flow_ToanPhan_Yes" name="Toàn phần" sourceRef="Gateway_CheckToanPhan" targetRef="End_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isToanPhan == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToanPhan_No" name="Không toàn phần" sourceRef="Gateway_CheckToanPhan" targetRef="Gateway_CheckStop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isToanPhan == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stop_Yes" name="Có" sourceRef="Gateway_CheckStop" targetRef="End_Stopped">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stopProcessing == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Stop_No" name="Không (Xử lý tiếp)" sourceRef="Gateway_CheckStop" targetRef="Gateway_HasFeedback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stopProcessing == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Common5">
    <bpmndi:BPMNPlane id="BPMNPlane_Common5" bpmnElement="SubProcess_Common5_Feedback">
      <bpmndi:BPMNShape id="Start_Common5_di" bpmnElement="Start_Common5">
        <dc:Bounds x="152" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="208" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HasFeedback_di" bpmnElement="Gateway_HasFeedback" isMarkerVisible="true">
        <dc:Bounds x="240" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="215" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ControlRebuild_di" bpmnElement="Task_ControlRebuild">
        <dc:Bounds x="350" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckToanPhan_di" bpmnElement="Gateway_CheckToanPhan" isMarkerVisible="true">
        <dc:Bounds x="505" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="208" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckStop_di" bpmnElement="Gateway_CheckStop" isMarkerVisible="true">
        <dc:Bounds x="505" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="345" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Completed_di" bpmnElement="End_Completed">
        <dc:Bounds x="662" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="646" y="208" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stopped_di" bpmnElement="End_Stopped">
        <dc:Bounds x="662" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="639" y="338" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="190" />
        <di:waypoint x="240" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HasFeedback_Yes_di" bpmnElement="Flow_HasFeedback_Yes">
        <di:waypoint x="290" y="190" />
        <di:waypoint x="350" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="313" y="165" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HasFeedback_No_di" bpmnElement="Flow_HasFeedback_No">
        <di:waypoint x="265" y="165" />
        <di:waypoint x="265" y="110" />
        <di:waypoint x="680" y="110" />
        <di:waypoint x="680" y="172" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="457" y="85" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="450" y="190" />
        <di:waypoint x="505" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToanPhan_Yes_di" bpmnElement="Flow_ToanPhan_Yes">
        <di:waypoint x="555" y="190" />
        <di:waypoint x="662" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="583" y="165" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToanPhan_No_di" bpmnElement="Flow_ToanPhan_No">
        <di:waypoint x="530" y="215" />
        <di:waypoint x="530" y="295" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="503" y="245" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stop_Yes_di" bpmnElement="Flow_Stop_Yes">
        <di:waypoint x="555" y="320" />
        <di:waypoint x="662" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="601" y="295" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stop_No_di" bpmnElement="Flow_Stop_No">
        <di:waypoint x="505" y="320" />
        <di:waypoint x="265" y="320" />
        <di:waypoint x="265" y="215" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="341" y="295" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
