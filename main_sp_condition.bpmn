      <bpmndi:BPMNShape id="Lane_DonViHoiTin_di" bpmnElement="Lane_DonViHoiTin" isHorizontal="false" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="160" y="80" width="380" height="1080" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_KetQuaTest_di" bpmnElement="Gateway_KetQuaTest" isMarkerVisible="true" bioc:stroke="#b85450" bioc:fill="#f8cecc">
