<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HoiTinDieuKien" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_HoiTinDieuKien">
    <bpmn:participant id="Participant_HoiTinDieuKien" name="Quy trình Tạo lập và cung cấp sản phẩm theo yêu cầu thủ công (theo điều kiện)" processRef="Process_HoiTinDieuKien" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HoiTinDieuKien" isExecutable="true">
    <bpmn:laneSet id="LaneSet_HoiTinDieuKien">
      <bpmn:lane id="Lane_DonViHoiTin" name="Đơn vị hỏi tin">
        <bpmn:flowNodeRef>End_KhongPhanHoi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CICCore">
        <bpmn:flowNodeRef>Task_8_1_DongGoiCungCapSanPham</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5_TongHopDuLieuTheoDoiTuong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6_TongHopDuLieuTaoLapSanPham</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CanBoCIC" name="Cán bộ CIC">
        <bpmn:flowNodeRef>Gateway_KetQuaTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7_2_DieuChinhCongThucCauHinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4_2_ChonChiTieuMauBaoCao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0zlsqjd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7_1_KiemTraKetQuaTaoLap</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_KetQuaTest" name="Kết quả test" default="Flow_KetQuaTest_Failed_Task7_2">
      <bpmn:incoming>Flow_Task7_1_GatewayKetQuaTest</bpmn:incoming>
      <bpmn:outgoing>Flow_KetQuaTest_Passed_Task8_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_KetQuaTest_Failed_Task7_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Task_8_1_DongGoiCungCapSanPham" name="8.1. Đóng gói, cung cấp SP &#38; gửi phản mềm tính phí">
      <bpmn:incoming>Flow_KetQuaTest_Passed_Task8_1</bpmn:incoming>
      <bpmn:outgoing>Flow_13dk4u3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_7_2_DieuChinhCongThucCauHinh" name="7.2. Điều chỉnh lại công thức và cấu hình sản phẩm">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task5_Task7_2</bpmn:incoming>
      <bpmn:incoming>Flow_KetQuaTest_Failed_Task7_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task7_2_Task4_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Task_5_TongHopDuLieuTheoDoiTuong" name="5. Tổng hợp dữ liệu theo từng đối tượng được hỏi tin">
      <bpmn:incoming>Flow_Task4_2_Task5</bpmn:incoming>
      <bpmn:outgoing>Flow_Task5_Task6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Task5_Task7_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_4_2_ChonChiTieuMauBaoCao" name="4.2. Chọn chỉ tiêu, mẫu báo cáo &#38; Bấm thực hiện tạo lập SP">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task7_2_Task4_2</bpmn:incoming>
      <bpmn:incoming>Flow_1vq44so</bpmn:incoming>
      <bpmn:outgoing>Flow_Task4_2_Task5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Event_0zlsqjd" name="Bổ sung chi tiêu">
      <bpmn:outgoing>Flow_1vq44so</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Task5_Task6" sourceRef="Task_5_TongHopDuLieuTheoDoiTuong" targetRef="Task_6_TongHopDuLieuTaoLapSanPham" />
    <bpmn:sequenceFlow id="Flow_Task6_Task7_1" sourceRef="Task_6_TongHopDuLieuTaoLapSanPham" targetRef="Task_7_1_KiemTraKetQuaTaoLap" />
    <bpmn:sequenceFlow id="Flow_Task7_1_GatewayKetQuaTest" sourceRef="Task_7_1_KiemTraKetQuaTaoLap" targetRef="Gateway_KetQuaTest" />
    <bpmn:sequenceFlow id="Flow_KetQuaTest_Failed_Task7_2" name="Failed" sourceRef="Gateway_KetQuaTest" targetRef="Task_7_2_DieuChinhCongThucCauHinh" />
    <bpmn:sequenceFlow id="Flow_KetQuaTest_Passed_Task8_1" name="Passed" sourceRef="Gateway_KetQuaTest" targetRef="Task_8_1_DongGoiCungCapSanPham">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketQuaTest == "passed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task5_Task7_2" name="Lỗi" sourceRef="Task_5_TongHopDuLieuTheoDoiTuong" targetRef="Task_7_2_DieuChinhCongThucCauHinh" />
    <bpmn:sequenceFlow id="Flow_Task7_2_Task4_2" sourceRef="Task_7_2_DieuChinhCongThucCauHinh" targetRef="Task_4_2_ChonChiTieuMauBaoCao" />
    <bpmn:sequenceFlow id="Flow_Task4_2_Task5" sourceRef="Task_4_2_ChonChiTieuMauBaoCao" targetRef="Task_5_TongHopDuLieuTheoDoiTuong" />
    <bpmn:sequenceFlow id="Flow_1vq44so" sourceRef="Event_0zlsqjd" targetRef="Task_4_2_ChonChiTieuMauBaoCao" />
    <bpmn:sequenceFlow id="Flow_13dk4u3" sourceRef="Task_8_1_DongGoiCungCapSanPham" targetRef="End_KhongPhanHoi" />
    <bpmn:endEvent id="End_KhongPhanHoi">
      <bpmn:incoming>Flow_13dk4u3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Task_6_TongHopDuLieuTaoLapSanPham" name="6. Tổng hợp dữ liệu các ĐTHT và Tạo lập sản phẩm">
      <bpmn:incoming>Flow_Task5_Task6</bpmn:incoming>
      <bpmn:outgoing>Flow_Task6_Task7_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="Task_7_1_KiemTraKetQuaTaoLap" name="7.1. Kiểm tra kết quả tạo lập">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Task6_Task7_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task7_1_GatewayKetQuaTest</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HoiTinDieuKien">
    <bpmndi:BPMNPlane id="BPMNPlane_HoiTinDieuKien" bpmnElement="Collaboration_HoiTinDieuKien">
      <bpmndi:BPMNShape id="Participant_HoiTinDieuKien_di" bpmnElement="Participant_HoiTinDieuKien" isHorizontal="false">
        <dc:Bounds x="160" y="80" width="1390" height="1080" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CanBoCIC_di" bpmnElement="Lane_CanBoCIC" isHorizontal="false" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="860" y="80" width="690" height="1080" />
