  <bpmn:collaboration id="Collaboration_18xnj35">
    <bpmn:participant id="Participant_CicCreditInquiryRequest" name="Luồng gửi yêu cầu hỏi tin" processRef="Process_0yrwvv5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0yrwvv5" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0wmevy8">
      <bpmn:lane id="Lane_DataProvider" name="P.KSDL / P.DVTT">
        <bpmn:flowNodeRef>Activity_1ycgk3d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_DungTraLoiTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CicProcessing">
        <bpmn:flowNodeRef>Task_CheckAndIdentifyCic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageCalculateFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProductReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_09kgfd9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_09kh388</bpmn:flowNodeRef>
