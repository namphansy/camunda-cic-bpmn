        <bpmn:flowNodeRef>Task_CreateInquiryProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AggregateSubjectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InquiryValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessInquiryFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveAndValidateInquiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RequestChannel" name="Khách hàng / Web / H2H">
        <bpmn:flowNodeRef>End_InquiryCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_InquiryRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InquiryRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="End_InquiryCompleted" name="Hoàn tất yêu cầu hỏi tin">
      <bpmn:incoming>Flow_0htcsdz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_InquiryRequest" name="Gửi yêu cầu hỏi tin (Web/H2H)">
      <bpmn:outgoing>Flow_Start_SendInquiry</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Task_CheckAndIdentifyCic" name="3. Kiểm tra và xác định mã CIC của ĐTHT">
      <bpmn:incoming>Flow_ProcessFile_CheckCic</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCic_NeedAdjustmentGateway</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_PackageCalculateFee" name="7.1. Đóng gói, cung cấp SP và ghi nhận tạm tính phí">
      <bpmn:incoming>Flow_ProductReady_Package</bpmn:incoming>
      <bpmn:outgoing>Flow_0htcsdz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ProductReady" name="Sản phẩm đủ điều kiện cung cấp?">
      <bpmn:incoming>Flow_CreateProduct_ProductReadyGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ProductReady_Package</bpmn:outgoing>
      <bpmn:outgoing>Flow_0v5r9q7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_09kgfd9" name="Kiểm tra tính toàn phần">
      <bpmn:incoming>Flow_0v5r9q7</bpmn:incoming>
      <bpmn:outgoing>Flow_0qdp6xr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_09kh388" name="Có toàn phần ?" default="Flow_0rkm5mp">
      <bpmn:incoming>Flow_0qdp6xr</bpmn:incoming>
      <bpmn:outgoing>Flow_0rkm5mp</bpmn:outgoing>
      <bpmn:outgoing>Flow_02swmwg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1rdvb0r" name="Kết thúc luồng">
      <bpmn:incoming>Flow_0rkm5mp</bpmn:incoming>
      <bpmn:incoming>Flow_DungTraLoi_ActionEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1ycgk3d" name="Dừng trả lời">
      <bpmn:incoming>Flow_02swmwg</bpmn:incoming>
      <bpmn:outgoing>Flow_DungTraLoi_ActionEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Task_CreateInquiryProduct" name="6. Tổng hợp dữ liệu các ĐTHT và tạo lập sản phẩm">
      <bpmn:incoming>Flow_AggregateSubject_CreateProduct</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateProduct_ProductReadyGateway</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Task_AggregateSubjectData" name="5. Tổng hợp dữ liệu theo từng đối tượng được hỏi tin">
      <bpmn:incoming>Flow_CheckCic_NeedAdjustmentGateway</bpmn:incoming>
      <bpmn:incoming>Flow_0bxwyzk</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateSubject_CreateProduct</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Boundary_DungTraLoiTimeout" name="Timeout ? giờ" attachedToRef="Activity_1ycgk3d">
      <bpmn:outgoing>Flow_0bxwyzk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1mbc5hb">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0htcsdz" sourceRef="Task_PackageCalculateFee" targetRef="End_InquiryCompleted" />
    <bpmn:sequenceFlow id="Flow_Start_SendInquiry" sourceRef="Start_InquiryRequest" targetRef="Task_ReceiveAndValidateInquiry" />
    <bpmn:sequenceFlow id="Flow_CheckCic_NeedAdjustmentGateway" sourceRef="Task_CheckAndIdentifyCic" targetRef="Task_AggregateSubjectData" />
    <bpmn:sequenceFlow id="Flow_ProductReady_Package" name="Có" sourceRef="Gateway_ProductReady" targetRef="Task_PackageCalculateFee" />
    <bpmn:sequenceFlow id="Flow_CreateProduct_ProductReadyGateway" sourceRef="Task_CreateInquiryProduct" targetRef="Gateway_ProductReady" />
    <bpmn:sequenceFlow id="Flow_0v5r9q7" sourceRef="Gateway_ProductReady" targetRef="Activity_09kgfd9" />
    <bpmn:sequenceFlow id="Flow_0qdp6xr" sourceRef="Activity_09kgfd9" targetRef="Gateway_09kh388" />
    <bpmn:sequenceFlow id="Flow_0rkm5mp" name="Có" sourceRef="Gateway_09kh388" targetRef="Event_1rdvb0r" />
    <bpmn:sequenceFlow id="Flow_02swmwg" name="Không" sourceRef="Gateway_09kh388" targetRef="Activity_1ycgk3d">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coToanPhan == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DungTraLoi_ActionEnd" name="Có action" sourceRef="Activity_1ycgk3d" targetRef="Event_1rdvb0r" />
    <bpmn:sequenceFlow id="Flow_AggregateSubject_CreateProduct" sourceRef="Task_AggregateSubjectData" targetRef="Task_CreateInquiryProduct" />
    <bpmn:sequenceFlow id="Flow_0bxwyzk" sourceRef="Boundary_DungTraLoiTimeout" targetRef="Task_AggregateSubjectData" />
    <bpmn:endEvent id="End_InquiryRejected" name="Kết thúc từ chối">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_InquiryValid" name="Hợp lệ?" default="Flow_Invalid_Reject">
      <bpmn:incoming>Flow_ReceiveAndValidate_ValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_ProcessFile</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Invalid_Reject" name="Không" sourceRef="Gateway_InquiryValid" targetRef="Task_RejectInquiry" />
    <bpmn:sequenceFlow id="Flow_Valid_ProcessFile" name="Có" sourceRef="Gateway_InquiryValid" targetRef="Task_ProcessInquiryFile">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requestValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReceiveAndValidate_ValidGateway" sourceRef="Task_ReceiveAndValidateInquiry" targetRef="Gateway_InquiryValid" />
    <bpmn:serviceTask id="Task_ProcessInquiryFile" name="2.1. Xử lý file hỏi tin, bóc tách danh sách đối tượng">
      <bpmn:incoming>Flow_Valid_ProcessFile</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessFile_CheckCic</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ProcessFile_CheckCic" sourceRef="Task_ProcessInquiryFile" targetRef="Task_CheckAndIdentifyCic" />
    <bpmn:serviceTask id="Task_RejectInquiry" name="2.2. Từ chối và gửi thông báo">
      <bpmn:incoming>Flow_Invalid_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="Task_RejectInquiry" targetRef="End_InquiryRejected" />
    <bpmn:serviceTask id="Task_ReceiveAndValidateInquiry" name="2. Tiếp nhận yêu cầu và kiểm tra tính hợp lệ">
      <bpmn:incoming>Flow_Start_SendInquiry</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveAndValidate_ValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
